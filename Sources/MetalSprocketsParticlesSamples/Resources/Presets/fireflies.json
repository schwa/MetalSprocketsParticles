          {
            "module": {
              "function": {
                "function": {
                  "name": "fireflySpawn",
                  "parameters": [[0.3, 1.1, 0, 0]],
                  "source": "\/\/ Gives each firefly its own blink: custom.x = phase, custom.y = blinks per second, custom.z = wander seed.\n[[visible]] void fireflySpawn(thread ParticleState &particle, float deltaTime, float time, constant float4 *parameters) {\n    uint h = particle.id * 747796405u + 2891336453u;\n    h = ((h >> ((h >> 28u) + 4u)) ^ h) * 277803737u;\n    float a = float(h & 0xffffu) \/ 65535.0;\n    float b = float(h >> 16u) \/ 65535.0;\n    particle.custom = float4(a * 6.2831853, mix(parameters[0].x, parameters[0].y, b), a * 100.0 + b, 0);\n}"
                }
              }
            }
          }
        ],
        "update": [
          {
            "module": {
              "collision": {
                "collidesWithSceneDepth": false,
                "diesOnCollision": false,
                "friction": 0.2,
                "frictionVariation": 0,
                "radius": 0,
                "restitution": 0.4,
                "restitutionVariation": 0
              }
            }
          },
          {
            "module": {
              "function": {
                "function": {
                  "name": "fireflyUpdate",
                  "parameters": [[0.3, 1.1, 1, 0.25]],
                  "source": "\/\/ Blinks with the phase and rate stored at spawn: size and color pulse, and each firefly wanders on its own path.\n\/\/ parameters[0] = (slowest blinks per second, fastest, glow size, wander speed).\n[[visible]] void fireflyUpdate(thread ParticleState &particle, float deltaTime, float time, constant float4 *parameters) {\n    float4 settings = parameters[0];\n    float pulse = pow(0.5 + 0.5 * sin(particle.custom.x + time * particle.custom.y * 6.2831853), 6.0);\n    particle.size = mix(0.15, settings.z, pulse);\n    particle.color = float4(mix(float3(0.15, 0.35, 0.0), float3(0.75, 1.0, 0.15), pulse), mix(0.25, 1.0, pulse));\n    float seed = particle.custom.z;\n    float3 wander = float3(sin(time * 0.7 + seed), sin(time * 0.9 + seed * 1.7) * 0.5, cos(time * 0.6 + seed * 2.3));\n    particle.velocity = mix(particle.velocity, wander * settings.w, saturate(deltaTime * 2.0));\n}"
                }
              }
            }
          }
        ]
      },
